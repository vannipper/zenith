
    <Window x:Class="Core.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Core.Views"
        xmlns:xcad="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        Title="{Binding WindowTitle}" Height="900" Width="1400">

    <DockPanel>
        <xcad:DockingManager x:Name="dockingManager">
            <xcad:DockingManager.Theme>
                <themes:Vs2013DarkTheme/>
            </xcad:DockingManager.Theme>
            <xcad:DockingManager.Layout>
                <layout:LayoutRoot>

                    <layout:LayoutPanel Orientation="Vertical">
                        <layout:LayoutDocumentPane>
                            <layout:LayoutDocument Title="Viewport" ContentId="viewport">
                                <local:ViewportControl x:Name="viewport"/>
                            </layout:LayoutDocument>
                        </layout:LayoutDocumentPane>

                    </layout:LayoutPanel>

                </layout:LayoutRoot>
            </xcad:DockingManager.Layout>
        </xcad:DockingManager>
    </DockPanel>
</Window>
